PORT=3847

# --- Donation Alerts ---
# Удобный способ: в админке → бургер-меню → Donation Alerts → «Сохранить и подключить».
# Значения из админки имеют приоритет над .env.
# Альтернатива: прописать ключи здесь (если в админке ещё ничего не сохранено).
# 1. Создай приложение: https://www.donationalerts.com/application/clients
# 2. Redirect URI: http://127.0.0.1:3847/oauth/callback
# 3. Вставь Client ID и API Key в админке
DA_CLIENT_ID=
DA_CLIENT_SECRET=
DA_REDIRECT_URI=http://127.0.0.1:3847/oauth/callback

# Альтернатива: вставить готовый access_token вручную (тогда кнопка не нужна)
DA_ACCESS_TOKEN=
DA_USER_ID=

# true = пытаться подключить DA при старте (если есть токен)
DA_ENABLED=true

# --- DonatePay ---
# Админка: Платформы донатов → DonatePay
# Токен: https://donatepay.ru/page/api (или donatepay.eu)
# DONATEPAY_REGION=ru или eu
DONATEPAY_ACCESS_TOKEN=
DONATEPAY_REGION=ru
DONATEPAY_ENABLED=true

# --- DonateX ---
# Админка: Платформы донатов → DonateX
# Токен: кабинет DonateX → Настройки → «API и Доступ»
DONATEX_ACCESS_TOKEN=
DONATEX_ENABLED=true
